  "hints": [
    "BCD 码：高 4 位放十位数字，低 4 位放个位数字，例如 59 要变成 0x59。",
    "十位 = bin / 10，个位 = bin % 10。",
    "结果 = (十位 << 4) | 个位。59 -> (5 << 4) | 9 = 0x59 = 89。"
  ]
}
